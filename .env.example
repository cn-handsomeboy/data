# 蔗循智策 —— 环境变量配置示例
# 复制本文件为 .env 并填写真实值后启动 Docker
# 注意：.env 文件包含敏感信息，请勿提交到版本控制

# API 鉴权密钥（生产环境必须设置为强随机字符串，长度建议 >= 32）
SUGARCANE_API_KEY=change-me-to-a-strong-random-key

# CORS 来源白名单（生产环境必须配置具体域名，禁止 *）
# 多个来源用英文逗号分隔
SCZC_CORS_ORIGINS=*

# 是否允许跨域携带凭证（当 SCZC_CORS_ORIGINS=* 时强制为 false）
SCZC_CORS_CREDENTIALS=false

# 是否启用 Swagger/ReDoc API 文档（生产环境建议关闭）
SCZC_ENABLE_DOCS=true
