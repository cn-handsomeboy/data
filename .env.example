# 蔗循智策 —— 环境变量配置示例
# 复制本文件为 .env 并填写真实值后启动 Docker
# 注意：.env 文件包含敏感信息，请勿提交到版本控制

# API 鉴权密钥（生产环境必须设置为强随机字符串，长度建议 >= 32）
SUGARCANE_API_KEY=change-me-to-a-strong-random-key

# CORS 来源白名单（生产环境必须配置具体域名，禁止 *）
# 多个来源用英文逗号分隔
SCZC_CORS_ORIGINS=*

# 是否允许跨域携带凭证（当 SCZC_CORS_ORIGINS=* 时强制为 false）
SCZC_CORS_CREDENTIALS=false

# 是否启用 Swagger/ReDoc API 文档（生产环境建议关闭）
SCZC_ENABLE_DOCS=true

# ============================================================
# 大语言模型(LLM)增强配置（可选，用于决策报告润色 + 自然语言问数）
# 未配置 SCZC_LLM_API_KEY 时，系统自动回退到规则模板，功能不中断；
# LLM 仅负责报告表述润色与开放式答疑，不参与任何核心计算。
# ============================================================
# DeepSeek 开放平台申请的 API Key（https://platform.deepseek.com）
SCZC_LLM_API_KEY=

# OpenAI 兼容接口地址（默认 DeepSeek）
SCZC_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（DeepSeek 可用 deepseek-chat）
SCZC_LLM_MODEL=deepseek-chat

# 每次最大生成 token 数
SCZC_LLM_MAX_TOKENS=800

# 请求超时（秒）
SCZC_LLM_TIMEOUT_SEC=25

# 每分钟最大调用次数（防滥用，可收紧为 1；平台侧建议再设预算告警）
SCZC_LLM_RATE_LIMIT=10

# 采样温度（默认 0.3，倾向确定性、减少编造）
SCZC_LLM_TEMPERATURE=0.3
